{
  "name": "@zilliz/dsh-milvus",
  "version": "0.1.5",
  "description": "Milvus for DSH — a read-only Desktop and Web plugin for Agent and RAG developers",
  "type": "module",
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zilliztech/dsh-milvus.git"
  },
  "homepage": "https://github.com/zilliztech/dsh-milvus",
  "bugs": {
    "url": "https://github.com/zilliztech/dsh-milvus/issues"
  },
  "files": [
    "index.mjs",
    "profile-settings.mjs",
    "embedding-models.mjs",
    "embedding-provider.mjs",
    "embedding-check.mjs",
    "connection-check.mjs",
    "connection-status.mjs",
    "milvus-transport.mjs",
    "retrieval-schema.mjs",
    "retrieval-capabilities.mjs",
    "milvus-tools.mjs",
    "session-binding.mjs",
    "sdk-database.mjs",
    "client.js",
    "cordis.patch.yml"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:integration": "node --test tests/sdk-compatibility.integration.test.mjs",
    "test:integration:connection": "node --test tests/connection-check.integration.test.mjs",
    "test:integration:embeddings": "node --test tests/embedding-provider.integration.test.mjs",
    "test:integration:mutation": "node --test tests/sdk-mutation.integration.test.mjs",
    "test:integration:retrieval": "node --test tests/embedding-retrieval.integration.test.mjs",
    "test:integration:hybrid": "node --test tests/bm25-hybrid.integration.test.mjs"
  },
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.0-rc.2 <1.0.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@zilliz/milvus2-sdk-node": "3.0.4"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-connection": "*",
    "@deepseek-ai/dsh-credentials": "*",
    "@deepseek-ai/dsh-settings": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-client-connection": {
      "optional": true
    },
    "@deepseek-ai/dsh-credentials": {
      "optional": true
    },
    "@deepseek-ai/dsh-settings": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-connection": "next",
    "@deepseek-ai/dsh-credentials": "next",
    "@deepseek-ai/dsh-settings": "next",
    "@deepseek-ai/dsh-tools": "next",
    "@deepseek-ai/schemastery": "^3.18.1"
  }
}
